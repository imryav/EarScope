  (polyline (pts (xy 480 137) (xy 480 259)) (stroke (width 0.2) (type dot) (color 0 0 132 1)) (uuid "84755d40-1bd5-44db-a4ad-b2b2c1bd7586"))
  (text "1. POWER" (exclude_from_sim no) (at 13 24 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "0c3af9d1-cb2c-4c93-9b3d-d3359a03e5d6"))
  (text "USB 5 V comes from the Arduino.\nU3 turns it into a clean 3.3 V\n(+3V3_ANA) for the analog part." (exclude_from_sim no) (at 13 30 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "3e5e6385-aead-41de-a683-955c2510aee2"))
  (text "2. VIRTUAL GROUND  (VREF = 1.65 V)" (exclude_from_sim no) (at 178 24 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "7e3b2d0d-0355-48fa-a4fb-1404a87e3227"))
  (text "R5 + R6 split 3.3 V in half = 1.65 V.\nU2B buffers it so it stays steady.\nVREF is the signal's middle level, so it can swing up and down." (exclude_from_sim no) (at 178 30 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "26ec0ebf-db0a-4c24-8c38-ce6382549a22"))
  (text "3. OP-AMP POWER" (exclude_from_sim no) (at 353 24 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "f45958ac-6dcd-4220-ab10-736fa7041aef"))
  (text "Each op-amp gets 3.3 V.\nA 100 nF cap next to it\nfilters supply noise." (exclude_from_sim no) (at 353 30 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "927f05e5-06a8-4c0e-b1aa-a7b794e69fc4"))
  (text "6. TEST POINTS" (exclude_from_sim no) (at 488 24 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "3a918647-097f-4878-a943-1c8c25376c6b"))
  (text "Places to touch with a\nscope probe while testing." (exclude_from_sim no) (at 488 30 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "3daeb1c5-6a4f-4218-b813-bf6cf72ad571"))
  (text "4. SIGNAL CHAIN   earphone -> amplify x455 -> keep 5-45 Hz -> Arduino" (exclude_from_sim no) (at 13 132 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "18e704e6-73ab-4c4a-a5a9-c91a05e69975"))
  (text "4a. INPUT" (exclude_from_sim no) (at 13 140 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "c1564a0c-fe24-4b95-b1c9-e77d87b2ca62"))
  (text "3.5 mm jack. D1 protects from static.\nC1 blocks DC.  SW1: EAR = earphone,\nMIC = adds bias for a microphone." (exclude_from_sim no) (at 13 145 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "0163cdea-28b6-436b-95fc-1770b1ecc74c"))
  (text "4b. PREAMP  (U1A)" (exclude_from_sim no) (at 138 140 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "7e72e672-b333-41cf-9a36-7029291d53a5"))
  (text "Amplifies x455  (1 + R4/R2).\nC2 cuts radio noise." (exclude_from_sim no) (at 138 145 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "8efe9340-bde7-494a-9079-82bfbca32c27"))
  (text "4c. HIGH-PASS 5 Hz  (U1B)" (exclude_from_sim no) (at 253 140 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "14b1b65c-ff99-4258-8eee-ff7617ebc3ac"))
  (text "Removes slow drift below 5 Hz." (exclude_from_sim no) (at 253 145 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "760905df-d75b-41f8-b93b-4d33d45365f3"))
  (text "4d. LOW-PASS 45 Hz  (U2A)" (exclude_from_sim no) (at 368 140 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "82745668-306b-4746-8351-6cfd0fc5bcc5"))
  (text "Removes everything above 45 Hz." (exclude_from_sim no) (at 368 145 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "215b5168-97bd-4d53-9450-d00ec8e82831"))
  (text "4e. ADC FILTER" (exclude_from_sim no) (at 483 140 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "afd5798e-6497-417a-a286-a24cc974b517"))
  (text "R11 + C7 smooth the signal\ninto Arduino pin A1." (exclude_from_sim no) (at 483 145 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "f62a16a7-b12b-437f-9cfc-44ba19302bec"))
  (text "5. CONTROLLER  (ARDUINO NANO R4)" (exclude_from_sim no) (at 13 272 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "aa102495-0df6-4dc5-b3ac-fb93089928c0"))
  (text "Reads ADC_IN on pin A1, 500 times a second, and sends it to the PC over USB.\nAREF = 3.3 V sets the ADC range.  C13 filters AREF." (exclude_from_sim no) (at 13 278 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "2a091fce-c4ee-4183-a421-eb7de92c80a5"))
  (text "HOW IT WORKS" (exclude_from_sim no) (at 303 272 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "058bfda7-f381-4c67-8ce0-2fdb7e493185"))
  (text "Earphone (J1)  ->  Preamp x455  ->  5 Hz high-pass  ->  45 Hz low-pass\n->  Arduino A1 (14-bit ADC)  ->  USB  ->  PC (Python)" (exclude_from_sim no) (at 303 280 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid "7c59a0a7-811e-45ba-88c1-30f7c92864d3"))
