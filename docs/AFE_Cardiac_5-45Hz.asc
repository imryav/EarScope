TEXT 0 320 Left 2 ;.ac dec 200 0.05 1Meg
TEXT 0 352 Left 2 !.tran 0 5 0 startup
TEXT 864 -896 Left 2 ;Cardiac AFE (Arduino Nano R4 Target), single 3.3 V LDO supply (VCC_ANA = AREF): x455.5 (53.2 dB) preamp -> SK HPF 5 Hz -> SK LPF 45 Hz -> ADC RC driver, centred on VREF = 1.650 V (code 8192)
TEXT 0 416 Left 2 !.lib OPA365.lib
TEXT 0 448 Left 2 ;U1 = OPA2365 (SOIC-8/VSSOP-8): U1A preamp, U1B HPF.   U2 = OPA2365: U2A LPF, U2B VREF buffer
TEXT 400 -432 Left 2 ;Stage 1: Preamp x455.5 / 53.2 dB (U1A, RG=220, CF=1nF)
TEXT 960 -432 Left 2 ;Stage 2: Sallen-Key HPF 5 Hz (U1B)
TEXT 1584 -432 Left 2 ;Stage 3: Sallen-Key LPF 45 Hz (U2A, CBL -> VREF)
TEXT 760 -704 Left 2 ;Virtual ground: VREF = VCC_ANA/2 = 1.650 V (U2B buffer)
TEXT 16 512 Left 2 !.param RMIC_VAL=1G
TEXT 2560 192 Left 2 ;Stage 4: ADC Charge Reservoir & Anti-Kickback (ROUT=100, COUT=100nF -> GND)
